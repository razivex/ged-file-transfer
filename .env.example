# Copy this file to ".env" and fill in real values.
# .env is gitignored — never commit real credentials.

# =============================================================================
# Directories — origin (DOWNLOAD_DIR) and destiny (DEST_DIR)
# DOWNLOAD_DIR_USER / DOWNLOAD_DIR_PASSWORD are used only if a path is not
# already accessible (UNC / admin share). Leave empty for local folders.
# DEST_DIR_USER / DEST_DIR_PASSWORD are optional; if empty, DOWNLOAD_DIR_*
# is reused for the destiny share.
# =============================================================================
# DOWNLOAD_DIR=C:\ged\origem
# DOWNLOAD_DIR=\\OTHER-PC\c$\ged\origem
DOWNLOAD_DIR=
DOWNLOAD_DIR_USER=
DOWNLOAD_DIR_PASSWORD=

# DEST_DIR=C:\ged\destino
# DEST_DIR=\\OTHER-PC\c$\ged\destino
DEST_DIR=
DEST_DIR_USER=
DEST_DIR_PASSWORD=

# =============================================================================
# DB lookup
# DB_LOOKUP=true  → for each origin file, run SQL_FILE. The value it returns
#                   is the full destiny file name. No value leaves the file
#                   in DOWNLOAD_DIR. This is also the default when omitted.
# DB_LOOKUP=false → move every file from DOWNLOAD_DIR to DEST_DIR.
#                   The database is not used and files keep their names.
# SQL_FILE is a path inside this project folder. The .sql extension is optional,
# and a subfolder is allowed:
#   ged_lookup.sql | ged_lookup | query\sql | query\sql.sql | query/sql
# The .sql file stays on this machine (gitignored). The statement must bind
# :file_name and return the full destiny name. Naming rules belong in that
# file, not in the script. SQL_FILE is used only when lookup is on.
# When SQL_FILE is omitted, the script looks for ged_lookup.sql in the project.
# =============================================================================
DB_LOOKUP=true
SQL_FILE=ged_lookup.sql

# =============================================================================
# Oracle database — required only when DB_LOOKUP=true.
# =============================================================================
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=1521
DB_SERVICE=
